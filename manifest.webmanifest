{
  "name": "Rhomberg Connect",
  "short_name": "Rhomberg Connect",
  "description": "Rhomberg Connect customer, operational and executive demonstration experiences.",
  "id": "./",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f7f8",
  "theme_color": "#073b53",
  "categories": ["business", "productivity"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "assets/images/rhomberg-connect-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    { "src": "assets/images/rhomberg-connect-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Customer mobile",
      "short_name": "Connect",
      "url": "./preview/customer-mobile/",
      "icons": [{ "src": "assets/images/rhomberg-connect-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Rhomberg Connect mobile operations",
      "short_name": "Connect",
      "url": "./preview/internal-mobile/",
      "icons": [{ "src": "assets/images/rhomberg-connect-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Internal desktop",
      "short_name": "Desktop",
      "url": "./preview/internal-desktop/",
      "icons": [{ "src": "assets/images/rhomberg-connect-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Executive workflow demo",
      "short_name": "Executive",
      "url": "./demo/executive-workflow/",
      "icons": [{ "src": "assets/images/rhomberg-connect-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
