# Example names only. Do not place real secrets in this file.
RHOMBERG_ENVIRONMENT=staging
RHOMBERG_PUBLIC_API_URL=https://connect.rhomberg.co.za:8443/api/v1
RHOMBERG_CUSTOMER_APP_URL=https://connect-staging.example.invalid
RHOMBERG_INTERNAL_APP_URL=https://operations-staging.example.invalid
RHOMBERG_DATABASE_HOST=provided-through-it-secrets-management
RHOMBERG_DATABASE_NAME=rhomberg_platform
RHOMBERG_DATABASE_USER=provided-through-it-secrets-management
RHOMBERG_DATABASE_PASSWORD=provided-through-it-secrets-management
RHOMBERG_DOCUMENT_STORAGE=provided-by-it
RHOMBERG_EMAIL_PROVIDER=microsoft365-or-approved-smtp
RHOMBERG_MONITORING_PROVIDER=provided-by-it
RHOMBERG_CREDENTIAL_PDF_PASSWORD=
RFQ_TO_EMAIL=

# Phase 1 API — names and safe placeholders only.
RHOMBERG_API_ENV=development
RHOMBERG_API_HOST=127.0.0.1
RHOMBERG_API_PORT=3001
RHOMBERG_API_LOG_LEVEL=info
RHOMBERG_API_TRUST_PROXY=false
RHOMBERG_API_COOKIE_SECURE=false
RHOMBERG_API_COOKIE_NAME=rhomberg_session
RHOMBERG_API_SESSION_TTL_SECONDS=28800
RHOMBERG_API_SESSION_PEPPER=replace-with-secret-from-approved-secret-store
RHOMBERG_API_DATABASE_URL=postgresql://replace-with-approved-local-or-staging-connection
RHOMBERG_API_DATABASE_SSL=false
RHOMBERG_API_DATABASE_POOL_MAX=10
RHOMBERG_API_STORAGE_ADAPTER=local
RHOMBERG_API_LOCAL_STORAGE_ROOT=./private/api-documents
RHOMBERG_API_MAX_UPLOAD_BYTES=4194304
RHOMBERG_API_IDENTITY_MODE=local_password
RHOMBERG_API_BOOTSTRAP_USERNAME=
RHOMBERG_API_BOOTSTRAP_PASSWORD=
RHOMBERG_API_ALLOWED_ORIGINS=https://connect.rhomberg.co.za:8443,https://connect.rhomberg.co.za
RHOMBERG_API_SHUTDOWN_TIMEOUT_MS=10000
