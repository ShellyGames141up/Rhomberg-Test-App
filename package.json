{
  "name": "rhomberg-instruments-app-preview",
  "version": "5.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "node ./scripts/build-app.mjs",
    "dev:customer-desktop": "node ./scripts/dev-preview.mjs customer-desktop",
    "dev:customer-mobile": "node ./scripts/dev-preview.mjs customer-mobile",
    "dev:internal-mobile": "node ./scripts/dev-preview.mjs internal-mobile",
    "dev:internal-desktop": "node ./scripts/dev-preview.mjs internal-desktop",
    "dev:executive-demo": "node ./scripts/dev-preview.mjs executive-demo",
    "build:customer-desktop": "node ./scripts/build-preview.mjs customer-desktop",
    "build:customer-mobile": "node ./scripts/build-preview.mjs customer-mobile",
    "build:internal-mobile": "node ./scripts/build-preview.mjs internal-mobile",
    "build:internal-desktop": "node ./scripts/build-preview.mjs internal-desktop",
    "build:executive-demo": "node ./scripts/build-preview.mjs executive-demo",
    "build:previews": "node ./scripts/build-previews.mjs",
    "build:production": "node ./scripts/build-production.mjs",
    "build:internal-staging": "node ./scripts/build-internal-staging.mjs",
    "check:internal-staging": "node ./scripts/check-internal-staging-artifact.mjs",
    "check:android": "node ./scripts/check-android-project.mjs",
    "android:sync": "pnpm run build:internal-staging && cap sync android",
    "android:bundle": "pnpm run android:sync && cd android && gradlew.bat bundleRelease",
    "api:dev": "pnpm --filter @rhomberg/connect-api dev",
    "api:start": "pnpm --filter @rhomberg/connect-api start",
    "api:migrate": "pnpm --filter @rhomberg/connect-api migrate",
    "api:bootstrap-admin": "pnpm --filter @rhomberg/connect-api bootstrap:admin",
    "api:test": "node --test --test-concurrency=1 apps/api/test/*.test.js",
    "check:production-artifact": "node ./scripts/check-production-artifact.mjs",
    "release:metadata": "node ./scripts/generate-release-metadata.mjs",
    "build:netlify": "npm run build && node ./scripts/stage-static.mjs",
    "check": "node ./scripts/check-app.mjs",
    "check:css": "node ./scripts/check-css.mjs",
    "check:private-staff": "node ./scripts/validate-private-staff.mjs",
    "docs:private-staff": "node ./scripts/generate-private-account-matrix.mjs",
    "docs:private-credentials": "node ./scripts/run-private-credentials.mjs",
    "test": "node ./tests/run-tests.mjs",
    "test:visual": "node ./scripts/capture-visual-regression.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "pdf-lib": "1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "esbuild": "^0.28.1"
  }
}
